<!doctype html>
<html lang="kk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WEB БАҒДАРЛАМАЛАУ — Дәрістер жинағы</title>
<style>
:root{color-scheme:dark;--gold:#d5b77b;--ink:#121d31}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#263e5a 0%,#111a2b 62%,#090f1b 100%);color:#f8f6f0;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;min-height:100vh}.top{max-width:1150px;margin:auto;padding:25px 20px 10px;display:flex;justify-content:space-between;align-items:center;gap:12px}.eyebrow{color:var(--gold);letter-spacing:.2em;font-size:11px;font-weight:800}.top h1{font-size:clamp(20px,3vw,32px);margin:6px 0}.top p{margin:0;color:#b9c7d6;font-size:13px}.pill{border:1px solid #52627b;border-radius:20px;padding:8px 13px;color:#d2ddec;font-size:12px;white-space:nowrap}.stage{max-width:1150px;margin:5px auto 0;padding:12px 18px 0}.book-shell{margin:auto;width:min(100%,750px);position:relative;perspective:1500px}.book-shell:before{content:'';position:absolute;inset:7px -10px -8px 10px;background:#e6d9bd;border-radius:7px;box-shadow:0 24px 45px #0008}.page{position:relative;background:#fff;border-radius:4px;overflow:hidden;box-shadow:0 16px 40px #0007;transform-origin:left center;transition:transform .28s ease,opacity .28s ease;cursor:pointer;touch-action:pan-y}.page canvas{display:block;width:100%;height:auto}.page.flip-next{transform:rotateY(-24deg) translateX(-8px);opacity:.55}.page.flip-prev{transform:rotateY(20deg) translateX(8px);opacity:.65}.page:after{content:'';pointer-events:none;position:absolute;inset:0;box-shadow:inset 16px 0 22px -20px #0008}.toolbar{display:flex;justify-content:center;align-items:center;gap:9px;flex-wrap:wrap;margin:22px auto 10px;padding:10px;background:#ffffff0e;border:1px solid #ffffff20;border-radius:18px;max-width:900px}.toolbar button,.toolbar a{border:1px solid #71829a66;background:#25344c;color:white;border-radius:10px;min-width:41px;padding:11px 13px;font-size:14px;cursor:pointer;text-decoration:none}.toolbar button:hover,.toolbar a:hover{background:#3c5271}.toolbar button:disabled{opacity:.35;cursor:default}.toolbar .counter{font-size:13px;color:#d4deea;min-width:100px;text-align:center}.toolbar input{width:58px;padding:9px;background:#111d30;border:1px solid #7485a0;border-radius:8px;color:#fff;text-align:center}.hint{text-align:center;color:#9baec3;font-size:12px;margin:13px 0 25px}.status{text-align:center;padding:10px;color:#f1d2a0}.footer{text-align:center;color:#8193aa;font-size:12px;padding:10px 20px 25px}@media(max-width:550px){.pill{display:none}.top{padding-top:16px}.toolbar{gap:5px}.toolbar button,.toolbar a{padding:10px;min-width:35px}.stage{padding:8px}.hint{line-height:1.6}}
</style></head><body>
<header class="top"><div><div class="eyebrow">ЭЛЕКТРОНДЫҚ ОҚУЛЫҚ · 2026</div><h1>WEB БАҒДАРЛАМАЛАУ</h1><p>15 дәріс · Интерактивті кітап</p></div><span class="pill">С. Сейфуллин атындағы ҚАТЗУ</span></header>
<main class="stage"><div id="status" class="status">Кітап жүктелуде…</div><div class="book-shell" id="shell" hidden><div class="page" id="page" title="Келесі бет"><canvas id="canvas"></canvas></div></div>
<div class="toolbar"><button id="first" title="Бірінші бет">⇤</button><button id="prev" title="Алдыңғы бет">←</button><span class="counter" id="counter">— / —</span><button id="next" title="Келесі бет">→</button><button id="last" title="Соңғы бет">⇥</button><button id="zoomOut" title="Кішірейту">−</button><button id="zoomIn" title="Үлкейту">＋</button><input id="jump" type="number" min="1" aria-label="Бет нөмірі" placeholder="Бет"><button id="go">Өту</button><button id="fullscreen" title="Толық экран">⛶</button><a href="book/backend.pdf" download="WEB_BAGDARLAMALAU_15_daris.pdf" title="PDF жүктеу">↓ PDF</a></div>
<p class="hint">← → пернелерімен немесе бетке басып парақтаңыз. Бет нөмірін енгізіп, «Өту» басыңыз.</p></main><footer class="footer">Ақпаратты жаңарту үшін GitHub-тағы book/backend.pdf файлын жаңа PDF-пен алмастырыңыз.</footer>
<script type="module">
const status=document.getElementById('status'),shell=document.getElementById('shell'),pageEl=document.getElementById('page'),canvas=document.getElementById('canvas'),ctx=canvas.getContext('2d'),counter=document.getElementById('counter'),jump=document.getElementById('jump');let pdf=null,current=1,scale=1,busy=false,renderTask=null;const buttons=['first','prev','next','last'].map(id=>document.getElementById(id));
try{
const pdfjs=await import('https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.min.mjs');pdfjs.GlobalWorkerOptions.workerSrc='https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.worker.min.mjs';pdf=await pdfjs.getDocument({url:'book/backend.pdf'}).promise;status.hidden=true;shell.hidden=false;await render();
}catch(e){console.error(e);status.textContent='PDF ашылмады. GitHub-та book/backend.pdf бар екенін және интернет қосылғанын тексеріңіз.';}
async function render(){if(!pdf)return;if(renderTask){renderTask.cancel();try{await renderTask.promise}catch(e){}renderTask=null}const p=await pdf.getPage(current);const v=p.getViewport({scale:1});const available=Math.min(window.innerWidth-40,750);const fit=Math.min(available/v.width,1.35);const dpr=Math.min(window.devicePixelRatio||1,2);const viewport=p.getViewport({scale:fit*scale*dpr});canvas.width=Math.round(viewport.width);canvas.height=Math.round(viewport.height);canvas.style.width=(viewport.width/dpr)+'px';canvas.style.height=(viewport.height/dpr)+'px';shell.style.width=canvas.style.width;renderTask=p.render({canvasContext:ctx,viewport});try{await renderTask.promise}catch(e){if(e.name!=='RenderingCancelledException')throw e}counter.textContent=`${current} / ${pdf.numPages}`;jump.max=pdf.numPages;buttons[0].disabled=buttons[1].disabled=current===1;buttons[2].disabled=buttons[3].disabled=current===pdf.numPages}
async function go(n,direction=0){if(!pdf||busy)return;const next=Math.max(1,Math.min(pdf.numPages,Number(n)||1));if(next===current)return;busy=true;pageEl.classList.add(direction<0?'flip-prev':'flip-next');await new Promise(r=>setTimeout(r,150));current=next;await render();pageEl.classList.remove('flip-next','flip-prev');busy=false}
document.getElementById('first').onclick=()=>go(1,-1);document.getElementById('prev').onclick=()=>go(current-1,-1);document.getElementById('next').onclick=()=>go(current+1,1);document.getElementById('last').onclick=()=>go(pdf?.numPages,1);document.getElementById('go').onclick=()=>go(jump.value);jump.onkeydown=e=>{if(e.key==='Enter')go(jump.value)};document.getElementById('zoomIn').onclick=async()=>{scale=Math.min(2,scale+.15);await render()};document.getElementById('zoomOut').onclick=async()=>{scale=Math.max(.6,scale-.15);await render()};document.getElementById('fullscreen').onclick=()=>{if(!document.fullscreenElement)document.documentElement.requestFullscreen?.();else document.exitFullscreen?.()};pageEl.onclick=e=>go(current+(e.offsetX<pageEl.clientWidth*.25?-1:1),e.offsetX<pageEl.clientWidth*.25?-1:1);document.addEventListener('keydown',e=>{if(e.target.tagName==='INPUT')return;if(e.key==='ArrowRight')go(current+1,1);if(e.key==='ArrowLeft')go(current-1,-1)});let startX=0;pageEl.addEventListener('touchstart',e=>{startX=e.changedTouches[0].clientX},{passive:true});pageEl.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-startX;if(Math.abs(dx)>50)go(current+(dx<0?1:-1),dx<0?1:-1)},{passive:true});
</script></body></html>
